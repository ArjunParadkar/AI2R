# Azure launcher config — edit before `bash azure/provision.sh`.  All scripts source this.
AZ_SUB="${AZ_SUB:-}"                       # subscription id (blank = az default)
AZ_RG="${AZ_RG:-wb-sprint}"                # resource group (teardown.sh deletes it whole)
AZ_LOC="${AZ_LOC:-southcentralus}"         # region with the GPU quota (see README step 1)
AZ_STORAGE="${AZ_STORAGE:-wbsprint$(printf '%04x' $((RANDOM)))}" # 3-24 lowercase alnum, globally unique; provision.sh pins it into config.local.env
AZ_CONTAINER="wb"
AZ_SAS_HOURS=48
AZ_SPOT="${AZ_SPOT:-0}"                    # 1 = Spot VMs (~60-80 % cheaper, may be evicted; every job is --resume-able)
AZ_ADMIN=wb
# VM sizes: T4 16 GB for the small models / F2 shards, A100 80 GB for the gemma-2-9b jobs
AZ_SKU_T4="Standard_NC8as_T4_v3"           # 8 vCPU 56 GB RAM  (~$0.75/h)
AZ_SKU_A100="Standard_NC24ads_A100_v4"     # 24 vCPU 220 GB RAM, A100 80 GB (~$3.7/h)
AZ_IMAGE="Canonical:ubuntu-24_04-lts:server:latest"   # python 3.12; NVIDIA driver via the GPU driver VM extension
F2_SHARDS="${F2_SHARDS:-20}"
F2_VALID_BUDGET=300000000                  # fits the 56 GB T4 VM (laptop uses 150 M on 20 GB; cluster sbatch 500 M on 64 GB)
[ -f "$(dirname "${BASH_SOURCE[0]}")/config.local.env" ] && source "$(dirname "${BASH_SOURCE[0]}")/config.local.env"
