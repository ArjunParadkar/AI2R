# --- Environments ----------------------------------------------------------
# `venv` is a symlink to the original untouched repo's environment, and
# site_pkgs/ is a local --no-deps install of transformers (~150M) loaded via
# PYTHONPATH. Both are machine-specific; see README for how to recreate them.
venv
site_pkgs/

__pycache__/
*.pyc

# --- Datasets --------------------------------------------------------------
# CIFAR-10 (~350M extracted + tarball) is public and re-downloaded on demand.
# The Gutenberg source texts, the cached general corpus, COMPAS and the
# toxicity set are small enough to keep, so the experiments stay reproducible.
data/cifar-10-python.tar.gz
data/cifar-10-batches-py/

# --- Heavy artifacts -------------------------------------------------------
# Model checkpoints are regenerated by the experiment scripts. Figures,
# metrics JSON, tables and logs under results/ ARE tracked -- they are the
# scientific record.
*.pt
*.pth
*.ckpt

# --- Install logs ----------------------------------------------------------
pip_install.log
pip2.log

# Local run-state pointers (timestamps of the last run on this machine)
.run_ts
.run_ts_3h
.run_3h_dir
